#cloud-config
hostname: {{ router_lab_vm.hostname }}
manage_etc_hosts: true
ssh_pwauth: false
disable_root: false
runcmd:
  - |
      export DEBIAN_FRONTEND=noninteractive
      if ! dpkg -s qemu-guest-agent >/dev/null 2>&1; then
        apt-get update && apt-get install -y qemu-guest-agent || true
      fi
      systemctl enable --now qemu-guest-agent || true

users:
  - name: lane
    gecos: lane
    groups: [adm, sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
{% for ssh_key in router_lab_ssh_authorized_keys %}
      - {{ ssh_key }}
{% endfor %}
